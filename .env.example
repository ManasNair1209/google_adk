# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# --- Gemini via Google AI Studio (simplest path) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-google-ai-studio-api-key

# --- OR Gemini via Vertex AI (comment the two lines above, uncomment these) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Optional: real weather data for the Day 4 MCP server ---
# If left blank, the MCP server falls back to simulated weather.
OPENWEATHER_API_KEY=
